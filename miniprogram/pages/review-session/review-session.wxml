<view class="review-session">
  <view wx:if="{{ loading }}" class="text-center">
    <view class="spinner"></view>
  </view>
  
  <view wx:elif="{{ !session }}" class="card text-center">
    <h3>Session Not Found</h3>
    <p>The review session could not be found or has expired.</p>
    <button bindtap="goBack" class="btn">Back to Review</button>
  </view>
  
  <view wx:elif="{{ session.completed }}" class="session-completed">
    <view class="card text-center">
      <h3>🎉 Session Complete!</h3>
      <view class="completion-stats">
        <view class="stat-item">
          <strong>{{ session.correctAnswers || 0 }}</strong>
          <span>Correct Answers</span>
        </view>
        <view class="stat-item">
          <strong>{{ session.totalQuestions || 0 }}</strong>
          <span>Total Questions</span>
        </view>
        <view class="stat-item">
          <strong>{{ calculateAccuracy() }}%</strong>
          <span>Accuracy</span>
        </view>
        <view class="stat-item">
          <strong>{{ formatDuration() }}</strong>
          <span>Duration</span>
        </view>
      </view>
      
      <!-- Performance Analysis -->
      <view class="performance-analysis">
        <h4>Performance Analysis</h4>
        <view class="analysis-grid">
          <view class="analysis-item">
            <span class="analysis-label">Strong Areas:</span>
            <span class="analysis-value">{{ strongAreas.join(', ') || 'None identified' }}</span>
          </view>
          <view class="analysis-item">
            <span class="analysis-label">Needs Review:</span>
            <span class="analysis-value">{{ weakAreas.join(', ') || 'None identified' }}</span>
          </view>
        </view>
      </view>
      
      <view class="completion-actions">
        <button bindtap="showAddToTodoModal" class="btn">Add to Todo List</button>
        <button bindtap="goBackToReview" class="btn btn-secondary">Start Another Session</button>
        <button bindtap="goToVocabulary" class="btn btn-secondary">View Vocabulary</button>
      </view>
    </view>
  </view>
  
  <view wx:elif="{{ session && !session.completed }}" class="active-session">
    <!-- Session Progress -->
    <view class="session-progress">
      <view class="progress-header">
        <text class="progress-title">Review Progress</text>
        <view class="progress-actions">
          <button bindtap="togglePause" class="btn btn-secondary">
            {{ sessionPaused ? 'Resume' : 'Pause' }}
          </button>
          <button bindtap="confirmEndSession" class="btn btn-outline">
            End Session
          </button>
        </view>
      </view>
      <view class="progress-bar">
        <view class="progress-fill" style="width: {{ (currentQuestionIndex + 1) / (session.totalQuestions || 1) * 100 }}%"></view>
      </view>
      <view class="progress-info">
        <text class="progress-text">Card {{ currentQuestionIndex + 1 }} of {{ session.totalQuestions || 0 }}</text>
        <text class="accuracy-text">Accuracy: {{ calculateAccuracy() }}%</text>
      </view>
    </view>

    <!-- Add to Todo List Button -->
    <view class="session-actions">
      <button bindtap="showAddToTodoModal" class="btn btn-secondary">Add to Todo List</button>
    </view>

    <!-- Current Question -->
    <view wx:if="{{ currentQuestion && !sessionPaused }}" class="question-container">
      <!-- Question Header -->
      <view class="question-header">
        <h4>{{ getQuestionHeader() }}</h4>
        <view class="question-meta">
          <span class="question-number">Card {{ currentQuestion.position }} of {{ currentQuestion.total }}</span>
          <span wx:if="{{ currentQuestion.dueDate }}" class="due-date">Due: {{ formatDueDate(currentQuestion.dueDate) }}</span>
          <span wx:if="{{ currentQuestion.interval }}" class="interval-info">Interval: {{ currentQuestion.interval }} days</span>
        </view>
      </view>

      <!-- Flashcard -->
      <view class="flashcard-container">
        <view class="flashcard" class="{{ isFlipped ? 'flipped' : '' }}" bindtap="flipCard">
          <!-- Front of card -->
          <view class="flashcard-front">
            <view class="flashcard-content">
              <view class="highlight-text">
                {{ currentQuestion.text || 'No text available' }}
                <button wx:if="{{ currentQuestion.text }}" bindtap="speakText" data-text="{{ currentQuestion.text }}" class="btn-speak" title="Speak this word/phrase">
                  🔊
                </button>
              </view>
              <div class="flip-hint">Click to see answer</div>
            </view>
          </view>
          
          <!-- Back of card -->
          <view class="flashcard-back">
            <view class="flashcard-content">
              <view class="back-text">
                {{ currentQuestion.backText || 'No answer available' }}
                <button wx:if="{{ currentQuestion.backText }}" bindtap="speakText" data-text="{{ currentQuestion.backText }}" class="btn-speak" title="Speak this answer">
                  🔊
                </button>
              </view>
              <div class="flip-hint">Click to go back</div>
            </view>
          </view>
        </view>
      </view>

      <!-- Context Section -->
      <view wx:if="{{ currentQuestion.context }}" class="context-section">
        <h5>Context</h5>
        <div class="context-text">
          <p>{{ currentQuestion.context }}</p>
        </div>
      </view>
      
      <!-- User Comment Section -->
      <view wx:if="{{ currentQuestion.userComment }}" class="comment-section">
        <button type="button" bindtap="toggleComment" class="btn-toggle-comment">
          {{ showComment ? 'Hide My Note' : 'Show My Note' }}
        </button>
        <view wx:if="{{ showComment }}" class="user-comment">
          <p>{{ currentQuestion.userComment }}</p>
        </view>
      </view>
      
      <!-- Answer Buttons -->
      <view class="answer-buttons">
        <button bindtap="submitAnswer" data-quality="BLACKOUT" class="answer-btn blackout-btn" disabled="{{ submittingAnswer }}">
          <span class="btn-emoji">😵</span>
          <span>Again</span>
        </button>
        <button bindtap="submitAnswer" data-quality="REMEMBERED" class="answer-btn remembered-btn" disabled="{{ submittingAnswer }}">
          <span class="btn-emoji">😅</span>
          <span>Hard</span>
        </button>
        <button bindtap="submitAnswer" data-quality="DIFFICULT" class="answer-btn difficult-btn" disabled="{{ submittingAnswer }}">
          <span class="btn-emoji">🙂</span>
          <span>Good</span>
        </button>
        <button bindtap="submitAnswer" data-quality="PERFECT" class="answer-btn perfect-btn" disabled="{{ submittingAnswer }}">
          <span class="btn-emoji">😊</span>
          <span>Easy</span>
        </button>
      </view>

      <!-- Navigation Buttons -->
      <view wx:if="{{ questions.length }}" class="question-nav">
        <button bindtap="goPrev" class="btn btn-secondary" disabled="{{ currentQuestionIndex <= 0 }}">
          Previous
        </button>
        <button bindtap="goNext" class="btn btn-secondary" disabled="{{ currentQuestionIndex >= questions.length - 1 }}">
          Next
        </button>
      </view>
    </view>

    <!-- Paused State -->
    <view wx:elif="{{ sessionPaused }}" class="paused-state card text-center">
      <h4>Session Paused</h4>
      <p>Take your time. Click resume when you're ready to continue.</p>
      <button bindtap="togglePause" class="btn">Resume Session</button>
    </view>

    <!-- Loading next question -->
    <view wx:elif="{{ !session.completed }}" class="text-center">
      <view class="spinner"></view>
      <p>Loading next question...</p>
    </view>
  </view>

  <!-- Add to Todo List Modal -->
  <view wx:if="{{ showAddToTodoModal }}" class="modal-overlay" catchtap="closeAddToTodoModal">
    <view class="modal" catchtap="">
      <view class="modal-header">
        <h3>Add Review Session to Todo List</h3>
        <button bindtap="closeAddToTodoModal" class="close-btn">&times;</button>
      </view>
      <view class="modal-body">
        <view class="form-group">
          <label class="form-label">Title</label>
          <input bindinput="onTodoTitleChange" value="{{ todoForm.title }}" class="form-control" placeholder="Enter title" />
        </view>
        <view class="form-group">
          <label class="form-label">Description</label>
          <textarea bindinput="onTodoDescriptionChange" value="{{ todoForm.description }}" class="form-control" placeholder="Enter description" rows="3" />
        </view>
        <view class="form-group">
          <label class="form-label">Due Date</label>
          <input bindinput="onTodoDueDateChange" value="{{ todoForm.dueDate }}" class="form-control" placeholder="YYYY-MM-DD" />
        </view>
        <view class="form-actions">
          <button bindtap="closeAddToTodoModal" class="btn btn-secondary">Cancel</button>
          <button bindtap="addToTodoList" class="btn btn-primary" disabled="{{ addingToTodo }}">
            {{ addingToTodo ? 'Adding...' : 'Add to Todo List' }}
          </button>
        </view>
      </view>
    </view>
  </view>
</view>

