.review-session {
  max-width: 1000rpx;
  margin: 0 auto;
  padding: 20rpx;
  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
  min-height: 100vh;
}

.text-center {
  text-align: center;
}

.spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #667eea;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin: 0 auto 1rem;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.card {
  background: white;
  border-radius: 20rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
  padding: 2rem;
  margin: 20rpx 0;
}

.card h3 {
  color: #667eea;
  font-size: 2rem;
  margin-bottom: 1.5rem;
  text-align: center;
  font-weight: 700;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.card p {
  color: #666;
  font-size: 1rem;
  line-height: 1.6;
  margin-bottom: 1.5rem;
}

.btn {
  transition: all 0.3s ease;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  padding: 0.75rem 1.5rem;
  border-radius: 12rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
  transition: all 0.3s ease;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.btn:hover:not(:disabled) {
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 16rpx rgba(102, 126, 234, 0.4);
}

.btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
  transform: none;
  box-shadow: none;
}

.btn-secondary {
  background: linear-gradient(135deg, #6c757d 0%, #495057 100%);
  box-shadow: 0 4rpx 12rpx rgba(108, 117, 125, 0.3);
}

.btn-secondary:hover {
  box-shadow: 0 6rpx 16rpx rgba(108, 117, 125, 0.4);
}

.btn-outline {
  background: transparent;
  color: #1e293b;
  border: 2rpx solid #e2e8f0;
}

/* Session Progress */
.session-progress {
  margin: 1.5rem 0;
  padding: 1.5rem;
  background: white;
  border-radius: 16rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.1);
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1rem;
}

.progress-title {
  font-size: 1.25rem;
  font-weight: 600;
  color: #333;
}

.progress-actions {
  display: flex;
  gap: 12rpx;
}

.progress-bar {
  height: 8rpx;
  background: #e2e8f0;
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 1rem;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.progress-text {
  font-size: 0.9rem;
  color: #666;
}

.accuracy-text {
  font-size: 0.9rem;
  font-weight: 600;
  color: #667eea;
}

/* Session Actions */
.session-actions {
  margin: 1.5rem 0;
  display: flex;
  justify-content: center;
}

/* Question Container */
.question-container {
  margin-top: 2rem;
  animation: fadeIn 0.5s ease forwards;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Question Header */
.question-header {
  text-align: center;
  margin-bottom: 2rem;
  padding-bottom: 1.5rem;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.2);
}

.question-header h4 {
  margin: 0 0 1rem 0;
  color: white;
  font-size: 1.8rem;
  font-weight: 700;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

.question-meta {
  color: rgba(255, 255, 255, 0.9);
  font-size: 0.9rem;
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
  justify-content: center;
  margin-top: 0.5rem;
}

.question-number {
  background-color: rgba(255, 255, 255, 0.2);
  padding: 0.4rem 1rem;
  border-radius: 16rpx;
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  transition: all 0.3s ease;
}

.question-number:hover {
  background-color: rgba(255, 255, 255, 0.3);
  transform: translateY(-2rpx);
}

.due-date {
  background-color: rgba(255, 255, 255, 0.2);
  padding: 0.4rem 1rem;
  border-radius: 16rpx;
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  transition: all 0.3s ease;
}

.due-date:hover {
  background-color: rgba(255, 255, 255, 0.3);
  transform: translateY(-2rpx);
}

.interval-info {
  background-color: rgba(255, 255, 255, 0.2);
  padding: 0.4rem 1rem;
  border-radius: 16rpx;
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  transition: all 0.3s ease;
}

.interval-info:hover {
  background-color: rgba(255, 255, 255, 0.3);
  transform: translateY(-2rpx);
}

/* Flashcard */
.flashcard-container {
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 2rem 0;
  perspective: 1200rpx;
  width: 100%;
}

.flashcard {
  width: 100%;
  max-width: 600rpx;
  height: 500rpx;
  position: relative;
  transform-style: preserve-3d;
  transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  cursor: pointer;
  border-radius: 20rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
}

.flashcard.flipped {
  transform: rotateY(180deg);
}

.flashcard-front,
.flashcard-back {
  position: absolute;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  border-radius: 20rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 2rem 1.5rem;
  background: white;
  color: #333;
  transition: all 0.3s ease;
  overflow-y: auto;
}

.flashcard-back {
  transform: rotateY(180deg);
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  color: white;
}

.flashcard-content {
  width: 100%;
  text-align: center;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 1rem;
}

.highlight-text {
  font-size: 2rem;
  font-weight: 700;
  color: #333;
  line-height: 1.4;
  margin-bottom: 0.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0 0.5rem;
  flex-direction: column;
  word-break: break-word;
}

.back-text {
  font-size: 1.6rem;
  font-weight: 600;
  color: white;
  line-height: 1.4;
  margin-bottom: 0.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0 0.5rem;
  flex-direction: column;
  word-break: break-word;
}

.btn-speak {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border: none;
  border-radius: 50%;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
  font-size: 1.2rem;
}

.btn-speak:hover {
  transform: scale(1.1);
  box-shadow: 0 6rpx 16rpx rgba(102, 126, 234, 0.4);
}

.flip-hint {
  margin-top: 1.5rem;
  color: #666;
  font-size: 0.9rem;
  opacity: 0.8;
  animation: pulse 2s infinite;
  font-style: italic;
}

.flashcard-back .flip-hint {
  color: rgba(255, 255, 255, 0.8);
}

@keyframes pulse {
  0%, 100% {
    opacity: 0.8;
  }
  50% {
    opacity: 1;
  }
}

/* Context Section */
.context-section {
  margin: 2rem 0;
  padding: 1.5rem;
  background-color: rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  transition: all 0.3s ease;
}

.context-section:hover {
  background-color: rgba(255, 255, 255, 0.25);
  transform: translateY(-2rpx);
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.1);
}

.context-section h5 {
  margin: 0 0 1rem 0;
  color: white;
  font-size: 1.1rem;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.context-section h5::before {
  content: '📝';
  font-size: 1.2rem;
}

.context-text p {
  margin: 0;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.6;
  font-size: 1rem;
  font-style: italic;
}

/* Comment Section */
.comment-section {
  margin: 1.5rem 0;
  padding: 1.5rem;
  background-color: rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  transition: all 0.3s ease;
}

.comment-section:hover {
  background-color: rgba(255, 255, 255, 0.25);
  transform: translateY(-2rpx);
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.1);
}

.btn-toggle-comment {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 0.8rem 1.5rem;
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 12rpx rgba(240, 147, 251, 0.3);
  margin-bottom: 1rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.btn-toggle-comment:hover {
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 16rpx rgba(240, 147, 251, 0.4);
}

.user-comment {
  background-color: rgba(255, 255, 255, 0.2);
  padding: 1.2rem;
  border-radius: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  animation: slideIn 0.3s ease forwards;
}

.user-comment p {
  margin: 0;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.6;
  font-size: 1rem;
}

@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Answer Buttons */
.answer-buttons {
  display: flex;
  gap: 1rem;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 2rem;
  padding-top: 1.5rem;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.answer-btn {
  flex: 1;
  min-width: 120rpx;
  padding: 1.2rem 2rem;
  border: none;
  border-radius: 16rpx;
  font-size: 1.1rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
}

.btn-emoji {
  font-size: 1.3rem;
  line-height: 1;
}

.answer-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  transition: left 0.5s ease;
}

.answer-btn:hover::before {
  left: 100%;
}

.answer-btn:hover {
  transform: translateY(-3rpx);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.15);
}

.answer-btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
  transform: none;
}

.blackout-btn {
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a52 100%);
  color: white;
}

.remembered-btn {
  background: linear-gradient(135deg, #feca57 0%, #ff9ff3 100%);
  color: white;
}

.difficult-btn {
  background: linear-gradient(135deg, #48dbfb 0%, #0abde3 100%);
  color: white;
}

.perfect-btn {
  background: linear-gradient(135deg, #1dd1a1 0%, #10ac84 100%);
  color: white;
}

/* Question Navigation */
.question-nav {
  margin-top: 1.25rem;
  display: flex;
  justify-content: center;
  gap: 12rpx;
}

.question-nav .btn {
  transition: all 0.3s ease;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  padding: 0.75rem 1.5rem;
  border-radius: 12rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
  transition: all 0.3s ease;
}

.question-nav .btn:hover:not(:disabled) {
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 16rpx rgba(102, 126, 234, 0.4);
}

.question-nav .btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
  transform: none;
  box-shadow: none;
}

/* Paused State */
.paused-state {
  margin-top: 2rem;
  padding: 3rem 2rem;
  animation: fadeIn 0.5s ease forwards;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  box-shadow: 0 20rpx 40rpx rgba(0, 0, 0, 0.15);
  color: white;
  text-align: center;
}

.paused-state h4 {
  margin: 0 0 1rem 0;
  color: white;
  font-size: 1.5rem;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

.paused-state p {
  margin: 0 0 2rem 0;
  color: rgba(255, 255, 255, 0.9);
  font-size: 1.1rem;
}

.paused-state .btn {
  background: white;
  color: #667eea;
  border: none;
  padding: 0.75rem 1.5rem;
  border-radius: 12rpx;
  font-weight: 600;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.paused-state .btn:hover {
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.15);
}

/* Session Completed */
.session-completed {
  animation: fadeIn 0.8s ease forwards;
}

.session-completed .card {
  background: white;
  border-radius: 20rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
  padding: 2rem;
  animation: slideIn 0.5s ease forwards;
}

.session-completed h3 {
  color: #667eea;
  font-size: 2rem;
  margin-bottom: 1.5rem;
  text-align: center;
  font-weight: 700;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.completion-stats {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(120rpx, 1fr));
  gap: 24rpx;
  margin: 32rpx 0;
  animation: fadeIn 0.5s ease forwards;
}

.stat-item {
  text-align: center;
  padding: 1.5rem;
  background: white;
  border-radius: 16rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.stat-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, #667eea, #764ba2);
}

.stat-item:hover {
  transform: translateY(-4rpx);
  box-shadow: 0 15rpx 35rpx rgba(0, 0, 0, 0.15);
}

.stat-item strong {
  display: block;
  font-size: 2.5rem;
  color: #667eea;
  margin-bottom: 8rpx;
  font-weight: 700;
}

.stat-item span {
  color: #666;
  font-size: 14rpx;
  text-transform: uppercase;
  letter-spacing: 0.5rpx;
}

/* Performance Analysis */
.performance-analysis {
  margin: 2rem 0;
  padding: 1.5rem;
  background: white;
  border-radius: 16rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.1);
  animation: fadeIn 0.5s ease forwards;
}

.performance-analysis h4 {
  margin: 0 0 1.5rem 0;
  color: #333;
  text-align: center;
  font-size: 1.25rem;
  font-weight: 600;
}

.analysis-grid {
  display: grid;
  gap: 1rem;
}

.analysis-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem;
  background: #f8f9fa;
  border-radius: 12rpx;
  border-left: 4rpx solid #667eea;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.analysis-item:hover {
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.1);
  transform: translateX(2rpx);
}

.analysis-label {
  font-weight: 600;
  color: #333;
}

.analysis-value {
  color: #666;
  text-align: right;
  flex: 1;
  margin-left: 1rem;
}

/* Completion Actions */
.completion-actions {
  display: flex;
  gap: 16rpx;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 2rem;
  animation: fadeIn 0.5s ease forwards;
}

.completion-actions .btn {
  transition: all 0.3s ease;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  padding: 0.75rem 1.5rem;
  border-radius: 12rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
  transition: all 0.3s ease;
}

.completion-actions .btn:hover {
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 16rpx rgba(102, 126, 234, 0.4);
}

.completion-actions .btn-secondary {
  background: linear-gradient(135deg, #6c757d 0%, #495057 100%);
  box-shadow: 0 4rpx 12rpx rgba(108, 117, 125, 0.3);
}

.completion-actions .btn-secondary:hover {
  box-shadow: 0 6rpx 16rpx rgba(108, 117, 125, 0.4);
}

/* Modal */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
  backdrop-filter: blur(4rpx);
  animation: fadeIn 0.3s ease forwards;
}

.modal {
  background: white;
  border-radius: 20rpx;
  width: 90%;
  max-width: 500rpx;
  max-height: 90vh;
  overflow-y: auto;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
  animation: slideIn 0.3s ease-out;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.5rem;
  border-bottom: 1rpx solid #f0f0f0;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx 20rpx 0 0;
  color: white;
}

.modal-header h3 {
  margin: 0;
  color: white;
  font-size: 1.25rem;
  font-weight: 600;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

.close-btn {
  background: none;
  border: none;
  font-size: 1.5rem;
  cursor: pointer;
  color: white;
  transition: all 0.3s ease;
  padding: 0.25rem;
  border-radius: 50%;
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-btn:hover {
  color: rgba(255, 255, 255, 0.8);
  background-color: rgba(255, 255, 255, 0.2);
}

.modal-body {
  padding: 1.5rem;
}

.todo-form {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.form-label {
  display: block;
  font-weight: 600;
  color: #333;
  font-size: 0.9rem;
}

.form-control {
  width: 100%;
  padding: 0.75rem 1rem;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  font-size: 1rem;
  background-color: #fff;
  transition: all 0.3s ease;
}

.form-control:focus {
  outline: none;
  border-color: #667eea;
  box-shadow: 0 0 0 3rpx rgba(102, 126, 234, 0.1);
}

.form-actions {
  display: flex;
  justify-content: flex-end;
  gap: 0.75rem;
  margin-top: 0.5rem;
}

.form-actions .btn {
  transition: all 0.3s ease;
  padding: 0.75rem 1.5rem;
  border-radius: 12rpx;
  font-weight: 600;
  transition: all 0.3s ease;
}

.form-actions .btn:hover:not(:disabled) {
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.15);
}

.form-actions .btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.form-actions .btn-secondary {
  background: #f8f9fa;
  color: #333;
  border: 2rpx solid #e2e8f0;
}

/* Mobile-First Responsive Design */
/* Default styles are for mobile (small screens) */
.review-session {
  padding: 20rpx;
}

.completion-actions {
  flex-direction: column;
  align-items: stretch;
}

.completion-actions .btn {
  width: 100%;
}

.analysis-item {
  flex-direction: column;
  text-align: center;
  gap: 0.5rem;
}

.analysis-value {
  text-align: center;
  margin-left: 0;
}

.completion-stats {
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.stat-item {
  padding: 1rem;
}

.stat-item strong {
  font-size: 2rem;
}

.flashcard {
  height: 500rpx;
  max-width: 100%;
}

.highlight-text {
  font-size: 2rem;
  flex-direction: column;
  gap: 0.5rem;
}

.back-text {
  font-size: 1.6rem;
  flex-direction: column;
  gap: 0.5rem;
}

.answer-buttons {
  flex-direction: column;
  gap: 0.75rem;
}

.answer-btn {
  width: 100%;
  min-width: auto;
}

.btn-speak {
  width: 48rpx;
  height: 48rpx;
  font-size: 1rem;
}

.question-nav {
  flex-direction: row;
  gap: 8rpx;
}

.question-nav .btn {
  flex: 1;
}

.progress-actions {
  flex-direction: row;
  gap: 8rpx;
}

.progress-actions .btn {
  flex: 1;
  padding: 0.5rem 0.75rem;
  font-size: 0.85rem;
}

.session-actions {
  margin: 1rem 0;
}

.session-actions .btn {
  width: 100%;
}

/* Tablet and larger screens */
@media (min-width: 768px) {
  .review-session {
    padding: 32rpx;
  }
  
  .completion-actions {
    flex-direction: row;
    justify-content: center;
    align-items: center;
  }
  
  .completion-actions .btn {
    width: auto;
    min-width: 150rpx;
  }
  
  .analysis-item {
    flex-direction: row;
    text-align: left;
  }
  
  .analysis-value {
    text-align: right;
    margin-left: 1rem;
  }
  
  .completion-stats {
    grid-template-columns: repeat(4, 1fr);
    gap: 24rpx;
  }
  
  .stat-item {
    padding: 1.5rem;
  }
  
  .stat-item strong {
    font-size: 2.5rem;
  }
  
  .flashcard {
    height: 400rpx;
    max-width: 600rpx;
  }
  
  .highlight-text {
    font-size: 2.4rem;
    flex-direction: row;
  }
  
  .back-text {
    font-size: 2rem;
    flex-direction: row;
  }
  
  .answer-buttons {
    flex-direction: row;
    gap: 1rem;
  }
  
  .answer-btn {
    width: auto;
    min-width: 120rpx;
  }
  
  .btn-speak {
    width: 56rpx;
    height: 56rpx;
    font-size: 1.2rem;
  }
  
  .session-actions .btn {
    width: auto;
    min-width: 200rpx;
  }
}

/* Animations */
.review-question,
.question-header,
.flashcard-container,
.context-section,
.comment-section,
.answer-buttons {
  animation: fadeInUp 0.6s ease forwards;
}

.question-header {
  animation-delay: 0.1s;
}

.flashcard-container {
  animation-delay: 0.2s;
}

.context-section {
  animation-delay: 0.3s;
}

.comment-section {
  animation-delay: 0.4s;
}

.answer-buttons {
  animation-delay: 0.5s;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Question Loading */
.question-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 3rem;
  animation: fadeIn 0.5s ease forwards;
}

.question-loading p {
  margin-top: 1rem;
  color: #666;
  font-size: 1.1rem;
}

/* Ensure the review session takes full height on mobile */
.review-session {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.active-session {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.question-container {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.flashcard-container {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
