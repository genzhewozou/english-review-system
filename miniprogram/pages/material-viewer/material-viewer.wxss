.material-viewer {
  min-height: 100vh;
  background: linear-gradient(180deg, #f8fafc 0%, #e2e8f0 100%);
}

.viewer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background: white;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  position: sticky;
  top: 0;
  z-index: 100;
}

.back-button {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: none;
  border: none;
  color: #64748b;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.3s ease;
}

.back-button:active {
  color: #667eea;
}

.back-icon {
  font-size: 32rpx;
}

.header-actions {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.header-button {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  background-color: white;
  color: #64748b;
  font-size: 26rpx;
  font-weight: 500;
  transition: all 0.3s ease;
}

.header-button.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border-color: transparent;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.button-icon {
  font-size: 28rpx;
}

.selection-alert {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 24rpx;
  margin: 24rpx 32rpx;
  background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
  border-left: 8rpx solid #3b82f6;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(59, 130, 246, 0.1);
}

.alert-icon {
  font-size: 36rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.alert-text {
  flex: 1;
  font-size: 26rpx;
  color: #1e40af;
  line-height: 1.5;
}

.material-content {
  padding: 32rpx;
  max-width: 1200rpx;
  margin: 0 auto;
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 128rpx 0;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #e2e8f0;
  border-top: 6rpx solid #667eea;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #64748b;
}

.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 128rpx 0;
  text-align: center;
}

.error-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.6;
}

.error-text {
  font-size: 28rpx;
  color: #64748b;
  margin-bottom: 40rpx;
}

.error-button {
  padding: 20rpx 40rpx;
  border: none;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(102, 126, 234, 0.4);
}

.material-wrapper {
  background-color: white;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
}

.material-meta {
  padding: 32rpx;
  border-bottom: 2rpx solid #f1f5f9;
}

.material-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 20rpx;
  display: block;
}

.meta-info {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
}

.meta-icon {
  font-size: 28rpx;
}

.meta-label {
  color: #64748b;
  font-weight: 500;
}

.meta-value {
  color: #1e293b;
  font-weight: 600;
}

.content-section {
  padding: 32rpx;
  border-bottom: 2rpx solid #f1f5f9;
}

.content-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.content-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
}

.content-actions {
  display: flex;
  gap: 12rpx;
}

.content-button {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  background-color: white;
  color: #64748b;
  font-size: 26rpx;
  font-weight: 500;
  transition: all 0.3s ease;
}

.content-button:active {
  border-color: #667eea;
  color: #667eea;
}

.button-icon {
  font-size: 28rpx;
}

.content-area {
  display: grid;
  grid-template-columns: 1fr 350rpx;
  gap: 32rpx;
  align-items: start;
  padding: 32rpx;
}

.main-content {
  flex: 1;
  min-width: 0;
}

.content-section {
  min-height: 400rpx;
  line-height: 1.6;
}

.content-body {
  min-height: 400rpx;
  line-height: 1.6;
}

.cards-sidebar {
  position: sticky;
  top: 160rpx;
  max-height: calc(100vh - 200rpx);
  overflow-y: auto;
}

.sidebar-card {
  background-color: white;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
  border: 2rpx solid #f1f5f9;
}

.sidebar-header {
  padding: 24rpx;
  border-bottom: 2rpx solid #f1f5f9;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
}

.sidebar-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1e293b;
}

.cards-count {
  font-size: 24rpx;
  color: #64748b;
  background: white;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  font-weight: 600;
  border: 2rpx solid #e2e8f0;
}

.sidebar-body {
  padding: 24rpx;
}

.empty-cards {
  text-align: center;
  padding: 48rpx 24rpx;
  background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
  border-radius: 16rpx;
}

.empty-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
  margin: 16rpx 0;
  display: block;
}

.empty-text {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
}

.cards-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  max-height: 500rpx;
  overflow-y: auto;
}

.card-item {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
  border-radius: 16rpx;
  border-left: 6rpx solid #667eea;
}

.card-word {
  font-size: 26rpx;
  font-weight: 600;
  color: #1e293b;
}

.card-actions {
  display: flex;
  gap: 12rpx;
}

.action-button {
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  border: none;
  transition: all 0.3s ease;
}

.action-button:active {
  transform: scale(0.95);
}

.action-button.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.action-button.secondary {
  background: linear-gradient(135deg, #94a3b8 0%, #64748b 100%);
  color: white;
}

.card-modal {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 90%;
  max-width: 600rpx;
  max-height: 80vh;
  background-color: white;
  border-radius: 32rpx;
  overflow: hidden;
  z-index: 1001;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
  animation: slideUp 0.3s ease;
}

.rich-text {
  font-size: 28rpx;
  color: #1e293b;
}

.rich-text .heading-1 {
  font-size: 40rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 24rpx;
  margin-top: 40rpx;
}

.rich-text .heading-2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 20rpx;
  margin-top: 32rpx;
}

.rich-text .paragraph {
  margin-bottom: 24rpx;
  font-size: 28rpx;
  color: #64748b;
  line-height: 1.8;
}

.rich-text .highlight-target {
  cursor: pointer;
  display: inline;
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
  transition: all 0.3s ease;
}

.rich-text .highlight-target:active {
  background: linear-gradient(135deg, #e0e7ff 0%, #c7d2fe 100%);
}

.video-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 128rpx 0;
  background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
  border-radius: 20rpx;
  text-align: center;
}

.video-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.video-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 12rpx;
}

.video-hint {
  font-size: 24rpx;
  color: #64748b;
}

.article-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 128rpx 0;
  background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
  border-radius: 20rpx;
  text-align: center;
}

.article-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.article-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 12rpx;
}

.article-hint {
  font-size: 24rpx;
  color: #64748b;
}

.highlights-section {
  padding: 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
}

.highlights-count {
  font-size: 24rpx;
  color: #64748b;
  background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  font-weight: 600;
}

.empty-highlights {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 64rpx 0;
  background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
  border-radius: 20rpx;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 28rpx;
  color: #64748b;
}

.highlights-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.highlight-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
  border-radius: 20rpx;
  border-left: 6rpx solid #667eea;
}

.highlight-word {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
  flex: 1;
}

.highlight-actions {
  display: flex;
  gap: 12rpx;
}

.action-button {
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  border: none;
  transition: all 0.3s ease;
}

.action-button:active {
  transform: scale(0.95);
}

.action-button.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.action-button.secondary {
  background: linear-gradient(135deg, #94a3b8 0%, #64748b 100%);
  color: white;
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.vocabulary-modal {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 90%;
  max-width: 600rpx;
  max-height: 80vh;
  background-color: white;
  border-radius: 32rpx;
  overflow: hidden;
  z-index: 1001;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translate(-50%, -40rpx);
  }
  to {
    opacity: 1;
    transform: translate(-50%, 0);
  }
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 2rpx solid #f1f5f9;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: white;
}

.modal-close {
  background: none;
  border: none;
  font-size: 40rpx;
  color: white;
  padding: 4rpx;
  opacity: 0.9;
  transition: all 0.3s ease;
}

.modal-close:active {
  opacity: 1;
  transform: scale(0.9);
}

.modal-body {
  padding: 32rpx;
  flex: 1;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.form-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #1e293b;
}

.form-input {
  padding: 20rpx 24rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  font-size: 28rpx;
  transition: all 0.3s ease;
}

.form-input:focus {
  border-color: #667eea;
  box-shadow: 0 0 0 6rpx rgba(102, 126, 234, 0.1);
}

.form-textarea {
  padding: 20rpx 24rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  font-size: 28rpx;
  min-height: 160rpx;
  line-height: 1.6;
  transition: all 0.3s ease;
}

.form-textarea:focus {
  border-color: #667eea;
  box-shadow: 0 0 0 6rpx rgba(102, 126, 234, 0.1);
}

.picker-view {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #64748b;
  transition: all 0.3s ease;
}

.picker-view:active {
  border-color: #667eea;
}

.picker-arrow {
  font-size: 24rpx;
  color: #64748b;
}

.modal-footer {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding: 24rpx;
  border-top: 2rpx solid #f1f5f9;
  background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
}

.modal-button {
  padding: 20rpx 32rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  transition: all 0.3s ease;
}

.modal-button:active {
  transform: scale(0.95);
}

.modal-button.secondary {
  background-color: white;
  color: #64748b;
  border: 2rpx solid #e2e8f0;
}

.modal-button.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  box-shadow: 0 8rpx 20rpx rgba(102, 126, 234, 0.4);
}

@media (max-width: 768rpx) {
  .material-content {
    padding: 16rpx;
  }
  
  .viewer-header {
    flex-direction: column;
    align-items: stretch;
    gap: 12rpx;
    padding: 16rpx;
  }
  
  .header-actions {
    justify-content: space-between;
  }
  
  .material-meta {
    padding: 24rpx;
  }
  
  .content-section {
    padding: 24rpx;
  }
  
  .highlights-section {
    padding: 24rpx;
  }
  
  .content-header {
    flex-direction: column;
    align-items: stretch;
    gap: 12rpx;
  }
  
  .content-actions {
    justify-content: flex-end;
  }
  
  .highlight-item {
    flex-direction: column;
    align-items: stretch;
    gap: 12rpx;
  }
  
  .highlight-actions {
    justify-content: flex-end;
  }
}
