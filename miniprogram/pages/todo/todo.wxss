.todo {
  padding: 20rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #f8fafc 0%, #e2e8f0 100%);
}

.todo-header {
  margin-bottom: 32rpx;
  padding: 32rpx 24rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.25);
  position: relative;
  overflow: hidden;
}

.header-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: relative;
  z-index: 1;
}

.header-content .todo-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 0;
  display: block;
}

.header-content .btn-primary {
  min-width: 160rpx;
  padding: 12rpx 24rpx;
  font-size: 22rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  color: #667eea;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.header-content .btn-primary:active {
  background: linear-gradient(135deg, #e9ecef 0%, #dee2e6 100%);
  transform: translateY(-2rpx);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.todo-header::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -50%;
  width: 100%;
  height: 100%;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
}

.todo-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 8rpx;
  display: block;
  position: relative;
  z-index: 1;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.todo-subtitle {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
  display: block;
  position: relative;
  z-index: 1;
}

.actions-section {
  margin-bottom: 24rpx;
}

.action-buttons {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.action-buttons .btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 36rpx;
  border-radius: 16rpx;
  font-weight: 600;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  font-size: 24rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.btn:active {
  transform: scale(0.95);
}

.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  box-shadow: 0 6rpx 16rpx rgba(102, 126, 234, 0.4);
}

.btn-secondary {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  color: white;
  box-shadow: 0 6rpx 16rpx rgba(245, 87, 108, 0.3);
}

.btn-outline {
  background: transparent;
  color: #667eea;
  border: 2rpx solid #667eea;
  box-shadow: none;
}

.btn-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.btn-text {
  font-size: 24rpx;
}

.filter-section {
  margin-bottom: 24rpx;
  background: white;
  border-radius: 16rpx;
  padding: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.filter-row {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.filter-row picker {
  flex: 1;
  min-width: calc(50% - 6rpx);
}

.form-control {
  width: 100%;
  padding: 16rpx 20rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #1e293b;
  background: white;
  transition: all 0.3s ease;
  box-sizing: border-box;
}

.form-control:focus {
  border-color: #667eea;
  box-shadow: 0 0 0 6rpx rgba(102, 126, 234, 0.1);
}

.stats-section {
  margin-bottom: 24rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.stat-card {
  background: white;
  border-radius: 16rpx;
  padding: 20rpx 12rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.stat-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 6rpx;
}

.stat-label {
  display: block;
  font-size: 18rpx;
  color: #64748b;
  font-weight: 500;
}

.tasks-section {
  background: white;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.08);
}

.tasks-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f1f5f9;
}

.tasks-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
}

.tasks-count {
  font-size: 20rpx;
  color: #64748b;
  font-weight: 500;
  background: linear-gradient(135deg, #e0e7ff 0%, #c7d2fe 100%);
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 64rpx 0;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid #e2e8f0;
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-spinner.small {
  width: 32rpx;
  height: 32rpx;
  border-width: 3rpx;
}

.loading-text {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #64748b;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 64rpx 24rpx;
  text-align: center;
}

.empty-state-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
  animation: float 3s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-16rpx); }
}

.empty-state-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 12rpx;
}

.empty-state-description {
  font-size: 22rpx;
  color: #64748b;
  margin-bottom: 32rpx;
  line-height: 1.6;
}

.tasks-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.task-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
  border-left: 4rpx solid #667eea;
  position: relative;
  overflow: hidden;
}

.task-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 100%;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.03) 0%, rgba(118, 75, 162, 0.03) 100%);
  pointer-events: none;
}

.task-item:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.task-checkbox {
  padding-top: 6rpx;
}

.task-checkbox checkbox {
  transform: scale(1.1);
}

.task-content {
  flex: 1;
  min-width: 0;
}

.task-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 8rpx;
  gap: 12rpx;
  flex-wrap: wrap;
}

.task-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1e293b;
  flex: 1;
  line-height: 1.4;
}

.task-title.completed {
  text-decoration: line-through;
  color: #94a3b8;
}

.task-title.clickable {
  color: #667eea;
  text-decoration: underline;
}

.task-actions {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  align-items: flex-end;
}

.task-type {
  font-size: 16rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  text-align: right;
}

.task-type.review-session {
  background: linear-gradient(135deg, #e0e7ff 0%, #c7d2fe 100%);
  color: #3730a3;
}

.task-type:not(.review-session) {
  background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
  color: #92400e;
}

.btn.btn-sm {
  padding: 8rpx 16rpx;
  font-size: 18rpx;
  border-radius: 8rpx;
}

.delete-btn {
  background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%);
  color: #dc2626;
  box-shadow: 0 2rpx 8rpx rgba(220, 38, 38, 0.2);
}

.task-description {
  display: block;
  font-size: 20rpx;
  color: #64748b;
  line-height: 1.6;
  margin-bottom: 10rpx;
}

.task-description.completed {
  color: #94a3b8;
}

.task-meta {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
  align-items: center;
}

.due-date {
  font-size: 18rpx;
  color: #64748b;
  font-weight: 500;
  background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  white-space: nowrap;
}

.related-highlight {
  font-size: 18rpx;
  color: #64748b;
  font-weight: 500;
  background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  white-space: nowrap;
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.modal {
  background: white;
  border-radius: 24rpx;
  width: 90%;
  max-width: 600rpx;
  max-height: 80vh;
  overflow-y: auto;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.3);
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 2rpx solid #f1f5f9;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 24rpx 24rpx 0 0;
}

.modal-header text {
  font-size: 28rpx;
  font-weight: 700;
  color: white;
}

.close-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  border: none;
  color: white;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  transition: all 0.3s ease;
}

.close-btn:active {
  background: rgba(255, 255, 255, 0.3);
  transform: scale(0.9);
}

.modal-body {
  padding: 24rpx;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 10rpx;
}

textarea.form-control {
  min-height: 140rpx;
  resize: vertical;
}

.form-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.form-actions .btn {
  flex: 1;
}

.card {
  background: white;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.fade-in {
  animation: fadeInUp 0.6s ease forwards;
  opacity: 0;
}

.fade-in:nth-child(1) { animation-delay: 0.1s; }
.fade-in:nth-child(2) { animation-delay: 0.2s; }
.fade-in:nth-child(3) { animation-delay: 0.3s; }
.fade-in:nth-child(4) { animation-delay: 0.4s; }
.fade-in:nth-child(5) { animation-delay: 0.5s; }

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Responsive adjustments */
@media (max-width: 750rpx) {
  .todo {
    padding: 16rpx;
  }
  
  .todo-header {
    margin-bottom: 24rpx;
    padding: 24rpx 20rpx;
  }
  
  .header-content .todo-title {
    font-size: 32rpx;
  }
  
  .header-content .btn-primary {
    min-width: 140rpx;
    padding: 10rpx 20rpx;
    font-size: 20rpx;
  }
  
  .stats-section {
    grid-template-columns: repeat(2, 1fr);
    gap: 12rpx;
  }
  
  .stat-card {
    padding: 16rpx 12rpx;
  }
  
  .stat-value {
    font-size: 32rpx;
  }
  
  .stat-label {
    font-size: 16rpx;
  }
  
  .filter-row {
    flex-direction: column;
  }
  
  .filter-row picker {
    min-width: 100%;
  }
  
  .tasks-section {
    padding: 20rpx;
  }
  
  .task-item {
    padding: 16rpx;
    gap: 12rpx;
  }
  
  .task-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 8rpx;
  }
  
  .task-actions {
    flex-direction: row;
    width: 100%;
    justify-content: flex-end;
  }
  
  .task-type {
    order: -1;
  }
  
  .task-title {
    font-size: 24rpx;
  }
  
  .task-description {
    font-size: 18rpx;
  }
  
  .task-meta {
    flex-direction: column;
    align-items: flex-start;
    gap: 8rpx;
  }
  
  .due-date,
  .related-highlight {
    align-self: flex-start;
  }
  
  .form-actions {
    flex-direction: column;
  }
  
  .modal {
    width: 95%;
    border-radius: 20rpx;
  }
  
  .modal-header {
    padding: 20rpx;
    border-radius: 20rpx 20rpx 0 0;
  }
  
  .modal-body {
    padding: 20rpx;
  }
}
