.auth-container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  padding: 32rpx;
  background: linear-gradient(180deg, #f5f7fa 0%, #e8ecf1 100%);
  position: relative;
  overflow: hidden;
}

.auth-container::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(102, 126, 234, 0.05) 0%, transparent 70%);
  animation: rotate 30s linear infinite;
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.auth-card {
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  border-radius: 32rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.1);
  padding: 56rpx 40rpx;
  width: 100%;
  max-width: 640rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.04);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  z-index: 1;
}

.auth-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #667eea, #764ba2);
  border-radius: 32rpx 32rpx 0 0;
}

.auth-title {
  display: block;
  margin-top: 0;
  color: #2c3e50;
  text-align: center;
  margin-bottom: 48rpx;
  font-size: 52rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  position: relative;
}

.login-form {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.form-group {
  margin-bottom: 0;
  position: relative;
}

.form-label {
  display: block;
  font-weight: 600;
  color: #2c3e50;
  font-size: 28rpx;
  margin-bottom: 16rpx;
  text-align: left;
  letter-spacing: 0.5rpx;
}

.form-control {
  width: 100%;
  padding: 28rpx 32rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.08);
  border-radius: 20rpx;
  font-size: 28rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  color: #2c3e50;
  font-weight: 500;
  box-sizing: border-box;
}

.form-control:focus {
  outline: none;
  border-color: #667eea;
  box-shadow: 0 0 0 8rpx rgba(102, 126, 234, 0.1);
  background: #ffffff;
  transform: translateY(-2rpx);
}

.form-control:disabled {
  background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
  color: #94a3b8;
  cursor: not-allowed;
  border-color: rgba(0, 0, 0, 0.04);
}

.form-actions {
  margin-top: 48rpx;
  display: flex;
  justify-content: center;
}

.form-actions .btn {
  width: 100%;
  padding: 28rpx 48rpx;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 20rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  min-height: 96rpx;
  border: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.btn-primary:active {
  background: linear-gradient(135deg, #5a6fd6 0%, #6a4190 100%);
  transform: translateY(-2rpx);
  box-shadow: 0 12rpx 32rpx rgba(102, 126, 234, 0.4);
}

.btn-primary:disabled {
  background: linear-gradient(135deg, #e9ecef 0%, #dee2e6 100%);
  box-shadow: none;
  color: #6b7280;
  cursor: not-allowed;
}

.auth-link {
  text-align: center;
  margin-top: 40rpx;
  font-size: 28rpx;
  color: #6b7280;
  font-weight: 500;
  line-height: 1.6;
}

.auth-link .link {
  color: #667eea;
  text-decoration: none;
  font-weight: 700;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
}

.auth-link .link::after {
  content: '';
  position: absolute;
  bottom: -4rpx;
  left: 0;
  width: 0;
  height: 2rpx;
  background: linear-gradient(90deg, #667eea, #764ba2);
  transition: width 0.3s ease;
}

.auth-link .link:active {
  color: #764ba2;
}

.auth-link .link:active::after {
  width: 100%;
}

.error-message {
  margin-top: 32rpx;
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%);
  border: 2rpx solid #fecaca;
  border-radius: 20rpx;
  color: #dc2626;
  font-size: 28rpx;
  text-align: center;
  animation: fadeIn 0.4s ease;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(220, 38, 38, 0.1);
}

.success-message {
  margin-top: 32rpx;
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
  border: 2rpx solid #bbf7d0;
  border-radius: 20rpx;
  color: #16a34a;
  font-size: 28rpx;
  text-align: center;
  animation: fadeIn 0.4s ease;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(22, 163, 74, 0.1);
}

.loading-spinner {
  display: inline-block;
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  border-top-color: white;
  animation: spin 0.8s ease-in-out infinite;
  margin-right: 16rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (max-width: 768rpx) {
  .auth-container {
    padding: 24rpx;
  }
  
  .auth-card {
    padding: 48rpx 32rpx;
    max-width: 100%;
  }
  
  .auth-title {
    font-size: 44rpx;
    margin-bottom: 40rpx;
  }
  
  .form-actions {
    margin-top: 40rpx;
  }
  
  .form-label {
    font-size: 26rpx;
  }
  
  .form-control {
    font-size: 26rpx;
    padding: 24rpx 28rpx;
  }
  
  .form-actions .btn {
    padding: 24rpx 40rpx;
    font-size: 28rpx;
    min-height: 88rpx;
  }
}

@media (prefers-reduced-motion: reduce) {
  .loading-spinner {
    animation: none;
  }
  
  .error-message {
    animation: none;
  }
  
  .success-message {
    animation: none;
  }
  
  .form-control:focus {
    transform: none;
  }
  
  .auth-container::before {
    animation: none;
  }
}
