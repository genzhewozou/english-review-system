.materials {
  padding: 32rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #f8fafc 0%, #e2e8f0 100%);
}

.materials-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
  padding: 32rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
  position: relative;
  overflow: hidden;
}

.materials-header::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -50%;
  width: 100%;
  height: 100%;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
}

.page-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
  position: relative;
  z-index: 1;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.upload-button {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: linear-gradient(135deg, #ffffff 0%, rgba(255,255,255,0.9) 100%);
  color: #667eea;
  border: none;
  padding: 20rpx 32rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
  position: relative;
  z-index: 1;
}

.upload-button:active {
  transform: scale(0.95);
}

.button-icon {
  font-size: 32rpx;
}

.materials-controls {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 32rpx;
  padding: 24rpx;
  background: white;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.search-section {
  width: 100%;
  position: relative;
}

.search-input {
  width: 100%;
  padding: 20rpx 56rpx 20rpx 48rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  font-size: 28rpx;
  background-color: white;
  transition: all 0.3s ease;
}

.search-input:focus {
  border-color: #667eea;
  box-shadow: 0 0 0 6rpx rgba(102, 126, 234, 0.1);
}

.search-icon {
  position: absolute;
  left: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 32rpx;
  color: #64748b;
}

.clear-icon {
  position: absolute;
  right: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 28rpx;
  color: #64748b;
  padding: 4rpx;
}

.filter-section {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.type-filter,
.sort-select {
  min-width: 150rpx;
  flex: 1;
}

.picker-view {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  background-color: white;
  font-size: 28rpx;
  transition: all 0.3s ease;
}

.picker-view:focus {
  border-color: #667eea;
  box-shadow: 0 0 0 6rpx rgba(102, 126, 234, 0.1);
}

.picker-arrow {
  font-size: 24rpx;
  color: #64748b;
}

.loading-container {
  padding: 64rpx;
}

.skeleton {
  height: 200rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}

.empty-state {
  padding: 96rpx 32rpx;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.6;
  animation: float 3s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}

.empty-description {
  font-size: 28rpx;
  color: #64748b;
  margin-bottom: 32rpx;
}

.empty-button {
  padding: 20rpx 40rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  transition: all 0.3s ease;
}

.empty-button.secondary {
  background-color: white;
  color: #64748b;
  border: 2rpx solid #e2e8f0;
}

.empty-button.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  box-shadow: 0 8rpx 20rpx rgba(102, 126, 234, 0.4);
}

.materials-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320rpx, 1fr));
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.material-card {
  background-color: white;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
  transition: all 0.3s ease;
  border: 2rpx solid transparent;
}

.material-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.material-card-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
  border-bottom: 2rpx solid #f1f5f9;
}

.material-icon {
  font-size: 40rpx;
}

.material-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.material-card-body {
  padding: 24rpx;
}

.material-meta {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.meta-label {
  font-size: 24rpx;
  color: #64748b;
  min-width: 80rpx;
}

.meta-value {
  font-size: 24rpx;
  color: #1e293b;
  flex: 1;
}

.material-card-footer {
  display: flex;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
  border-top: 2rpx solid #f1f5f9;
}

.card-button {
  flex: 1;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  border: none;
  transition: all 0.3s ease;
}

.card-button.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.card-button.secondary {
  background: linear-gradient(135deg, #94a3b8 0%, #64748b 100%);
  color: white;
}

.card-button.danger {
  background: linear-gradient(135deg, #f87171 0%, #ef4444 100%);
  color: white;
}

.pagination-container {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}

.pagination {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.pagination-button {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  background-color: white;
  font-size: 28rpx;
  color: #64748b;
  transition: all 0.3s ease;
}

.pagination-button:active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border-color: transparent;
}

.pagination-button:disabled {
  color: #cbd5e1;
  border-color: #e2e8f0;
  background: #f8fafc;
}

.pagination-info {
  font-size: 28rpx;
  color: #64748b;
  min-width: 160rpx;
  text-align: center;
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.modal-content {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 90%;
  max-width: 800rpx;
  max-height: 80vh;
  background-color: white;
  border-radius: 32rpx;
  overflow: hidden;
  z-index: 1001;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translate(-50%, -40rpx);
  }
  to {
    opacity: 1;
    transform: translate(-50%, 0);
  }
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 2rpx solid #f1f5f9;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: white;
}

.modal-close {
  background: none;
  border: none;
  font-size: 40rpx;
  color: white;
  padding: 4rpx;
  opacity: 0.9;
  transition: all 0.3s ease;
}

.modal-close:active {
  opacity: 1;
  transform: scale(0.9);
}

.modal-body {
  padding: 32rpx;
  flex: 1;
  overflow-y: auto;
}

.upload-area {
  border: 2rpx dashed #cbd5e1;
  border-radius: 20rpx;
  padding: 64rpx 32rpx;
  text-align: center;
  background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
  margin-bottom: 24rpx;
  transition: all 0.3s ease;
}

.upload-area:active {
  border-color: #667eea;
  background: linear-gradient(135deg, #e0e7ff 0%, #c7d2fe 100%);
}

.upload-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.upload-text {
  font-size: 28rpx;
  color: #1e293b;
  margin-bottom: 8rpx;
  display: block;
  font-weight: 600;
}

.upload-hint {
  font-size: 24rpx;
  color: #64748b;
  display: block;
}

.files-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.file-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx;
  background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
  border-radius: 16rpx;
}

.file-name {
  font-size: 26rpx;
  color: #1e293b;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-size {
  font-size: 24rpx;
  color: #64748b;
  min-width: 120rpx;
  text-align: right;
}

.remove-file {
  background: none;
  border: none;
  font-size: 28rpx;
  color: #64748b;
  padding: 4rpx;
  transition: all 0.3s ease;
}

.remove-file:active {
  color: #ef4444;
  transform: scale(0.9);
}

.modal-footer {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding: 24rpx;
  border-top: 2rpx solid #f1f5f9;
  background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
}

.modal-button {
  padding: 20rpx 32rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  transition: all 0.3s ease;
}

.modal-button.secondary {
  background-color: white;
  color: #64748b;
  border: 2rpx solid #e2e8f0;
}

.modal-button.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  box-shadow: 0 8rpx 20rpx rgba(102, 126, 234, 0.4);
}

.modal-button:disabled {
  opacity: 0.6;
}

@media (min-width: 768rpx) {
  .materials-controls {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }
  
  .search-section {
    flex: 1;
    max-width: 400rpx;
  }
  
  .filter-section {
    flex-shrink: 0;
  }
}

@media (max-width: 768rpx) {
  .materials {
    padding: 16rpx;
  }
  
  .materials-header {
    flex-direction: column;
    gap: 16rpx;
    align-items: stretch;
    padding: 24rpx;
  }
  
  .page-title {
    font-size: 36rpx;
    text-align: center;
  }
  
  .upload-button {
    justify-content: center;
  }
  
  .materials-grid {
    grid-template-columns: 1fr;
  }
  
  .filter-section {
    flex-direction: column;
  }
  
  .type-filter,
  .sort-select {
    width: 100%;
  }
  
  .material-card-footer {
    flex-direction: column;
  }
  
  .card-button {
    width: 100%;
  }
}
