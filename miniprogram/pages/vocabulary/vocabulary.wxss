.vocabulary {
  padding: 24rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #f5f7fa 0%, #e8ecf1 100%);
  animation: fadeIn 0.4s ease forwards;
}

.vocabulary-header {
  margin-bottom: 32rpx;
  animation: fadeIn 0.4s ease forwards;
}

.vocabulary-title {
  font-size: 48rpx;
  font-weight: 800;
  color: #2c3e50;
  margin-bottom: 12rpx;
  display: block;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.vocabulary-subtitle {
  font-size: 28rpx;
  color: #6b7280;
  display: block;
  font-weight: 400;
  line-height: 1.5;
}

.actions-section {
  margin-bottom: 32rpx;
  animation: fadeIn 0.4s ease forwards;
  animation-delay: 0.1s;
}

.action-buttons {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.action-buttons .btn {
  flex: 1;
  min-width: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.btn-icon {
  font-size: 32rpx;
  font-weight: 700;
}

.filters-card {
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 32rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.04);
  animation: fadeIn 0.4s ease forwards;
  animation-delay: 0.2s;
}

.filter-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.filter-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2c3e50;
}

.filter-controls {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.filter-group {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.filter-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #6b7280;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.search-group {
  margin-top: 12rpx;
}

.search-input-group {
  position: relative;
  display: flex;
  align-items: center;
}

.search-clear-btn {
  position: absolute;
  right: 24rpx;
  background: rgba(255, 255, 255, 0.9);
  border: none;
  font-size: 28rpx;
  color: #9ca3af;
  padding: 0;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: all 0.2s ease;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.search-clear-btn:active {
  background-color: #e5e7eb;
  color: #2c3e50;
  transform: scale(0.95);
}

.form-control {
  width: 100%;
  padding: 24rpx 32rpx;
  border: 3rpx solid #e8ecf1;
  border-radius: 20rpx;
  font-size: 28rpx;
  background-color: #ffffff;
  color: #2c3e50;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-sizing: border-box;
  min-height: 88rpx;
}

.form-control:focus {
  border-color: #667eea;
  outline: none;
  box-shadow: 0 0 0 6rpx rgba(102, 126, 234, 0.1);
}

.cards-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  animation: fadeIn 0.4s ease forwards;
  animation-delay: 0.3s;
}

.cards-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2c3e50;
}

.cards-count {
  font-size: 26rpx;
  color: #6b7280;
  font-weight: 600;
  background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  border: 1px solid #bfdbfe;
}

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  gap: 24rpx;
  animation: fadeIn 0.4s ease forwards;
  animation-delay: 0.4s;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #e5e7eb;
  border-top: 6rpx solid #667eea;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loading-spinner.small {
  width: 48rpx;
  height: 48rpx;
  border-width: 4rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #6b7280;
  font-weight: 500;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  gap: 24rpx;
  text-align: center;
  animation: fadeIn 0.4s ease forwards;
  animation-delay: 0.4s;
}

.empty-state-icon {
  font-size: 128rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
  filter: grayscale(50%);
}

.empty-state-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 12rpx;
}

.empty-state-description {
  font-size: 28rpx;
  color: #9ca3af;
  margin-bottom: 32rpx;
  max-width: 80%;
  line-height: 1.6;
}

.cards-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  animation: fadeIn 0.4s ease forwards;
  animation-delay: 0.4s;
}

.card {
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.08);
  border: 2rpx solid rgba(0, 0, 0, 0.04);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, #667eea, #764ba2);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.card:active::before {
  opacity: 1;
}

.card-item:active {
  transform: translateY(-8rpx);
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.12);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.card-text-container {
  flex: 1;
  margin-right: 24rpx;
}

.card-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 12rpx;
  display: block;
  line-height: 1.3;
}

.card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.badge {
  padding: 8rpx 20rpx;
  border-radius: 40rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.badge-secondary {
  background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
  color: #667eea;
  border: 2rpx solid #bfdbfe;
  box-shadow: 0 2rpx 8rpx rgba(102, 126, 234, 0.1);
}

.card-actions {
  display: flex;
  gap: 12rpx;
}

.card-details {
  border-top: 2rpx solid #e8ecf1;
  padding-top: 24rpx;
}

.card-context {
  margin-bottom: 24rpx;
}

.card-comment {
  margin-bottom: 24rpx;
}

.detail-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #9ca3af;
  margin-bottom: 8rpx;
  display: block;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.detail-content {
  font-size: 28rpx;
  color: #6b7280;
  line-height: 1.6;
  font-weight: 400;
}

.card-meta {
  margin-top: 24rpx;
}

.meta-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.meta-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.meta-label {
  font-size: 22rpx;
  font-weight: 600;
  color: #9ca3af;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.meta-value {
  font-size: 26rpx;
  color: #6b7280;
  font-weight: 500;
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  animation: fadeIn 0.2s ease forwards;
  backdrop-filter: blur(8rpx);
}

.modal {
  background: #ffffff;
  border-radius: 32rpx;
  width: 90%;
  max-width: 1000rpx;
  max-height: 80vh;
  overflow-y: auto;
  box-shadow: 0 40rpx 80rpx rgba(0, 0, 0, 0.2);
  animation: slideUp 0.3s ease forwards;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 2rpx solid #e8ecf1;
  font-size: 36rpx;
  font-weight: 700;
  color: #2c3e50;
}

.close-btn {
  background: none;
  border: none;
  font-size: 48rpx;
  color: #9ca3af;
  padding: 0;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: all 0.2s ease;
  line-height: 1;
}

.close-btn:active {
  background-color: #e5e7eb;
  color: #2c3e50;
  transform: scale(0.95);
}

.modal-body {
  padding: 32rpx;
}

.form-group {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #6b7280;
  margin-bottom: 16rpx;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

textarea.form-control {
  min-height: 200rpx;
  resize: vertical;
  padding: 24rpx;
  line-height: 1.6;
}

.tag-selection {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 12rpx;
}

.tag-checkbox {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
  background-color: #f8f9fa;
  border: 2rpx solid #e8ecf1;
  transition: all 0.2s ease;
}

.tag-checkbox:active {
  background-color: #e9ecef;
  transform: scale(0.98);
}

.form-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
  justify-content: flex-end;
}

.tag-management {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.add-tag-form {
  padding: 24rpx;
  margin-bottom: 32rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  border-radius: 24rpx;
  border: 2rpx solid #e8ecf1;
}

.add-tag-form text:first-child {
  font-size: 32rpx;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 24rpx;
  display: block;
}

.tag-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tag-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 24rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  border-radius: 24rpx;
  border: 2rpx solid #e8ecf1;
  transition: all 0.2s ease;
}

.tag-item:active {
  background: linear-gradient(135deg, #e9ecef 0%, #dee2e6 100%);
  transform: translateX(4rpx);
}

.tag-info {
  flex: 1;
  margin-right: 24rpx;
}

.tag-info text:first-child {
  font-size: 28rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 8rpx;
  display: block;
}

.tag-info text:last-child {
  font-size: 26rpx;
  color: #6b7280;
  display: block;
  line-height: 1.5;
}

.tag-actions {
  display: flex;
  gap: 12rpx;
}

.tag-actions-footer {
  display: flex;
  justify-content: flex-end;
  margin-top: 24rpx;
}

.tag-guide {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.guide-section {
  padding: 24rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  border-radius: 24rpx;
  border: 2rpx solid #e8ecf1;
}

.guide-section text:first-child {
  font-size: 28rpx;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 12rpx;
  display: block;
}

.guide-section text:last-child {
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.6;
  display: block;
  font-weight: 400;
}

.guide-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 12rpx;
}

.guide-list text {
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.6;
  display: block;
  font-weight: 400;
}

.btn {
  padding: 24rpx 48rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  border: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  min-width: 160rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.btn-primary:active {
  background: linear-gradient(135deg, #5a6fd6 0%, #6a4190 100%);
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.4);
}

.btn-secondary {
  background: linear-gradient(135deg, #2ecc71 0%, #27ae60 100%);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(46, 204, 113, 0.3);
}

.btn-secondary:active {
  background: linear-gradient(135deg, #27ae60 0%, #229954 100%);
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(46, 204, 113, 0.4);
}

.btn-outline {
  background-color: transparent;
  color: #2c3e50;
  border: 3rpx solid #e8ecf1;
}

.btn-outline:active {
  background-color: #f8f9fa;
  border-color: #667eea;
  color: #667eea;
  transform: translateY(2rpx);
}

.btn-error {
  background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(231, 76, 60, 0.3);
}

.btn-error:active {
  background: linear-gradient(135deg, #c0392b 0%, #a93226 100%);
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(231, 76, 60, 0.4);
}

.btn-sm {
  padding: 16rpx 32rpx;
  font-size: 24rpx;
  border-radius: 12rpx;
  min-height: 64rpx;
  min-width: 120rpx;
}

.btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.fade-in {
  animation: fadeIn 0.4s ease forwards;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.action-dropdown {
  position: relative;
}

.dropdown-menu {
  position: absolute;
  top: 100%;
  right: 0;
  margin-top: 16rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
  min-width: 320rpx;
  z-index: 100;
  overflow: hidden;
  border: 2rpx solid #e8ecf1;
  animation: slideDown 0.2s ease forwards;
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.dropdown-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  color: #2c3e50;
  background: none;
  border: none;
  width: 100%;
  text-align: left;
  transition: all 0.2s ease;
  font-weight: 500;
}

.dropdown-item:active {
  background-color: #f8f9fa;
  color: #667eea;
}

.item-icon {
  font-size: 32rpx;
}

.btn-arrow {
  font-size: 24rpx;
  transition: transform 0.2s ease;
  margin-left: 8rpx;
}

.btn-arrow.rotated {
  transform: rotate(180deg);
}

@media (max-width: 768rpx) {
  .action-buttons {
    flex-direction: column;
  }
  
  .action-buttons .btn {
    width: 100%;
  }
  
  .meta-grid {
    grid-template-columns: 1fr;
  }
  
  .card-header {
    flex-direction: column;
    align-items: flex-start;
  }
  
  .card-actions {
    margin-top: 16rpx;
    align-self: flex-end;
  }
  
  .dropdown-menu {
    min-width: 280rpx;
  }
}
