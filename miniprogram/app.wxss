page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  color: #2c3e50;
  background-color: #f5f7fa;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

.container {
  padding: 24rpx;
  max-width: 100%;
  box-sizing: border-box;
}

.card {
  background-color: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  padding: 32rpx;
  margin-bottom: 24rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  border: 1px solid rgba(0, 0, 0, 0.04);
}

.card:active {
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  transform: translateY(-4rpx);
}

.card-header {
  padding-bottom: 24rpx;
  margin-bottom: 24rpx;
  border-bottom: 1px solid #e8ecf1;
}

.card-body {
  padding: 0;
}

.card-footer {
  padding-top: 24rpx;
  margin-top: 24rpx;
  border-top: 1px solid #e8ecf1;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 48rpx;
  border-radius: 16rpx;
  font-weight: 600;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  font-size: 28rpx;
  border: none;
  cursor: pointer;
  box-sizing: border-box;
  min-height: 88rpx;
  min-width: 160rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.btn-primary:active {
  background: linear-gradient(135deg, #5a6fd6 0%, #6a4190 100%);
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.4);
}

.btn-secondary {
  background: linear-gradient(135deg, #2ecc71 0%, #27ae60 100%);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(46, 204, 113, 0.3);
}

.btn-secondary:active {
  background: linear-gradient(135deg, #27ae60 0%, #229954 100%);
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(46, 204, 113, 0.4);
}

.btn-outline {
  background-color: transparent;
  color: #667eea;
  border: 3rpx solid #667eea;
}

.btn-outline:active {
  background-color: #667eea;
  color: white;
}

.btn-danger {
  background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(231, 76, 60, 0.3);
}

.btn-danger:active {
  background: linear-gradient(135deg, #c0392b 0%, #a93226 100%);
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(231, 76, 60, 0.4);
}

.btn-sm {
  padding: 16rpx 32rpx;
  font-size: 24rpx;
  border-radius: 12rpx;
  min-height: 64rpx;
  min-width: 120rpx;
}

.btn-lg {
  padding: 32rpx 64rpx;
  font-size: 32rpx;
  border-radius: 20rpx;
  min-height: 104rpx;
  min-width: 200rpx;
}

.btn-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.btn-text {
  font-size: 28rpx;
}

.form-group {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #34495e;
  margin-bottom: 16rpx;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.form-control {
  width: 100%;
  padding: 24rpx 32rpx;
  border: 3rpx solid #e8ecf1;
  border-radius: 20rpx;
  font-size: 28rpx;
  background-color: #ffffff;
  color: #2c3e50;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-sizing: border-box;
  min-height: 88rpx;
}

.form-control:focus {
  outline: none;
  border-color: #667eea;
  box-shadow: 0 0 0 6rpx rgba(102, 126, 234, 0.1);
}

.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 24rpx;
  border-radius: 40rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.badge-primary {
  background-color: #667eea;
  color: white;
}

.badge-success {
  background-color: #27ae60;
  color: white;
}

.badge-warning {
  background-color: #f39c12;
  color: white;
}

.badge-danger {
  background-color: #e74c3c;
  color: white;
}

.badge-info {
  background-color: #3498db;
  color: white;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 600;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.tag-blue {
  background-color: rgba(102, 126, 234, 0.1);
  color: #667eea;
}

.tag-green {
  background-color: rgba(46, 204, 113, 0.1);
  color: #2ecc71;
}

.tag-orange {
  background-color: rgba(243, 156, 18, 0.1);
  color: #f39c12;
}

.tag-red {
  background-color: rgba(231, 76, 60, 0.1);
  color: #e74c3c;
}

.tag-purple {
  background-color: rgba(155, 89, 182, 0.1);
  color: #9b59b6;
}

.divider {
  height: 1px;
  background-color: #e8ecf1;
  margin: 32rpx 0;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-state-icon {
  font-size: 128rpx;
  color: #bdc3c7;
  margin-bottom: 32rpx;
}

.empty-state-text {
  font-size: 32rpx;
  color: #7f8c8d;
  margin-bottom: 16rpx;
  font-weight: 600;
}

.empty-state-subtext {
  font-size: 28rpx;
  color: #95a5a6;
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid rgba(102, 126, 234, 0.2);
  border-radius: 50%;
  border-top-color: #667eea;
  animation: spin 0.8s ease-in-out infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.text-center {
  text-align: center;
}

.text-left {
  text-align: left;
}

.text-right {
  text-align: right;
}

.text-primary {
  color: #667eea;
}

.text-secondary {
  color: #2ecc71;
}

.text-accent {
  color: #e74c3c;
}

.text-success {
  color: #27ae60;
}

.text-warning {
  color: #f39c12;
}

.text-danger {
  color: #e74c3c;
}

.text-muted {
  color: #95a5a6;
}

.text-small {
  font-size: 24rpx;
}

.text-large {
  font-size: 36rpx;
}

.font-bold {
  font-weight: 700;
}

.font-semibold {
  font-weight: 600;
}

.font-medium {
  font-weight: 500;
}

