.m-1 { margin: 16rpx; }
.m-2 { margin: 32rpx; }
.m-3 { margin: 48rpx; }
.m-4 { margin: 64rpx; }

.mt-0 { margin-top: 0; }
.mt-1 { margin-top: 16rpx; }
.mt-2 { margin-top: 32rpx; }
.mt-3 { margin-top: 48rpx; }
.mt-4 { margin-top: 64rpx; }

.mb-0 { margin-bottom: 0; }
.mb-1 { margin-bottom: 16rpx; }
.mb-2 { margin-bottom: 32rpx; }
.mb-3 { margin-bottom: 48rpx; }
.mb-4 { margin-bottom: 64rpx; }

.ml-0 { margin-left: 0; }
.ml-1 { margin-left: 16rpx; }
.ml-2 { margin-left: 32rpx; }
.ml-3 { margin-left: 48rpx; }

.mr-0 { margin-right: 0; }
.mr-1 { margin-right: 16rpx; }
.mr-2 { margin-right: 32rpx; }
.mr-3 { margin-right: 48rpx; }

.p-0 { padding: 0; }
.p-1 { padding: 16rpx; }
.p-2 { padding: 32rpx; }
.p-3 { padding: 48rpx; }
.p-4 { padding: 64rpx; }

.pt-0 { padding-top: 0; }
.pt-1 { padding-top: 16rpx; }
.pt-2 { padding-top: 32rpx; }
.pt-3 { padding-top: 48rpx; }

.pb-0 { padding-bottom: 0; }
.pb-1 { padding-bottom: 16rpx; }
.pb-2 { padding-bottom: 32rpx; }
.pb-3 { padding-bottom: 48rpx; }

.pl-0 { padding-left: 0; }
.pl-1 { padding-left: 16rpx; }
.pl-2 { padding-left: 32rpx; }
.pl-3 { padding-left: 48rpx; }

.pr-0 { padding-right: 0; }
.pr-1 { padding-right: 16rpx; }
.pr-2 { padding-right: 32rpx; }
.pr-3 { padding-right: 48rpx; }

.flex {
  display: flex;
}

.flex-column {
  flex-direction: column;
}

.flex-row {
  flex-direction: row;
}

.items-center {
  align-items: center;
}

.items-start {
  align-items: flex-start;
}

.items-end {
  align-items: flex-end;
}

.justify-center {
  justify-content: center;
}

.justify-between {
  justify-content: space-between;
}

.justify-around {
  justify-content: space-around;
}

.justify-start {
  justify-content: flex-start;
}

.justify-end {
  justify-content: flex-end;
}

.flex-1 {
  flex: 1;
}

.flex-wrap {
  flex-wrap: wrap;
}

.gap-1 { gap: 16rpx; }
.gap-2 { gap: 32rpx; }
.gap-3 { gap: 48rpx; }
.gap-4 { gap: 64rpx; }

.w-full {
  width: 100%;
}

.h-full {
  height: 100%;
}

.rounded {
  border-radius: 16rpx;
}

.rounded-sm {
  border-radius: 8rpx;
}

.rounded-lg {
  border-radius: 24rpx;
}

.rounded-xl {
  border-radius: 32rpx;
}

.rounded-full {
  border-radius: 50%;
}

.shadow-sm {
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.08);
}

.shadow {
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.12);
}

.shadow-lg {
  box-shadow: 0 16rpx 32rpx rgba(0, 0, 0, 0.15);
}

.fade-in {
  animation: fadeIn 0.3s ease forwards;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.slide-in {
  animation: slideIn 0.3s ease forwards;
}

@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateX(-20rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.progress-bar {
  width: 100%;
  height: 16rpx;
  background-color: #e0e0e0;
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(to right, #667eea, #764ba2);
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.list-item {
  padding: 32rpx;
  border-bottom: 1px solid #e8ecf1;
  transition: all 0.3s ease;
}

.list-item:active {
  background-color: #f8f9fa;
}

.list-item:last-child {
  border-bottom: none;
}

.stat-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 32rpx;
  padding: 48rpx;
  color: white;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.3);
}

.stat-card-blue {
  background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
  box-shadow: 0 8rpx 32rpx rgba(52, 152, 219, 0.3);
}

.stat-card-green {
  background: linear-gradient(135deg, #2ecc71 0%, #27ae60 100%);
  box-shadow: 0 8rpx 32rpx rgba(46, 204, 113, 0.3);
}

.stat-card-orange {
  background: linear-gradient(135deg, #f39c12 0%, #d35400 100%);
  box-shadow: 0 8rpx 32rpx rgba(243, 156, 18, 0.3);
}

.stat-card-red {
  background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
  box-shadow: 0 8rpx 32rpx rgba(231, 76, 60, 0.3);
}

.stat-value {
  font-size: 72rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.stat-label {
  font-size: 28rpx;
  opacity: 0.9;
}

.input-group {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.input-group .form-control {
  flex: 1;
}

.search-box {
  position: relative;
}

.search-box .form-control {
  padding-left: 88rpx;
}

.search-icon {
  position: absolute;
  left: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #95a5a6;
  font-size: 32rpx;
}

.filter-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  padding: 32rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.filter-chip {
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  background-color: #f8f9fa;
  color: #6b7280;
  transition: all 0.3s ease;
  font-weight: 500;
}

.filter-chip.active {
  background-color: #667eea;
  color: white;
}

.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background-color: #ffffff;
  border-radius: 32rpx;
  padding: 48rpx;
  width: 90%;
  max-width: 1000rpx;
  box-shadow: 0 40rpx 80rpx rgba(0, 0, 0, 0.2);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
  padding-bottom: 32rpx;
  border-bottom: 1px solid #e8ecf1;
}

.modal-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #2c3e50;
}

.modal-body {
  margin-bottom: 40rpx;
}

.modal-footer {
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
  padding-top: 32rpx;
  border-top: 1px solid #e8ecf1;
}

.toast {
  position: fixed;
  top: 40rpx;
  left: 50%;
  transform: translateX(-50%);
  padding: 24rpx 48rpx;
  border-radius: 16rpx;
  color: white;
  font-size: 28rpx;
  font-weight: 500;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  z-index: 2000;
  animation: slideDown 0.3s ease forwards;
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateX(-50%) translateY(-40rpx);
  }
  to {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
}

.toast-success {
  background-color: #27ae60;
}

.toast-error {
  background-color: #e74c3c;
}

.toast-warning {
  background-color: #f39c12;
}

.toast-info {
  background-color: #3498db;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #667eea;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  font-size: 32rpx;
}

.avatar-sm {
  width: 64rpx;
  height: 64rpx;
  font-size: 28rpx;
}

.avatar-lg {
  width: 112rpx;
  height: 112rpx;
  font-size: 40rpx;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  background-color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.nav-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #2c3e50;
}

.tabs {
  display: flex;
  background-color: #ffffff;
  border-bottom: 1px solid #e8ecf1;
}

.tab-item {
  flex: 1;
  padding: 32rpx;
  text-align: center;
  font-size: 28rpx;
  color: #6b7280;
  transition: all 0.3s ease;
  position: relative;
  font-weight: 500;
}

.tab-item.active {
  color: #667eea;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 80rpx;
  height: 6rpx;
  background-color: #667eea;
  border-radius: 6rpx 6rpx 0 0;
}

.grid {
  display: grid;
  gap: 32rpx;
}

.grid-2 {
  grid-template-columns: repeat(2, 1fr);
}

.grid-3 {
  grid-template-columns: repeat(3, 1fr);
}

.grid-4 {
  grid-template-columns: repeat(4, 1fr);
}

.icon-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: transparent;
  color: #6b7280;
  transition: all 0.3s ease;
  font-size: 32rpx;
}

.icon-btn:active {
  background-color: #f3f4f6;
  color: #667eea;
}

.switch {
  width: 96rpx;
  height: 56rpx;
  background-color: #e8ecf1;
  border-radius: 28rpx;
  position: relative;
  transition: all 0.3s ease;
}

.switch.active {
  background-color: #667eea;
}

.switch-handle {
  width: 48rpx;
  height: 48rpx;
  background-color: white;
  border-radius: 50%;
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
}

.switch.active .switch-handle {
  left: 44rpx;
}

.rating {
  display: flex;
  gap: 8rpx;
}

.rating-star {
  font-size: 40rpx;
  color: #d1d5db;
  transition: color 0.3s ease;
}

.rating-star.active {
  color: #f39c12;
}

.timeline {
  position: relative;
  padding-left: 48rpx;
}

.timeline::before {
  content: '';
  position: absolute;
  left: 16rpx;
  top: 0;
  bottom: 0;
  width: 4rpx;
  background-color: #e8ecf1;
}

.timeline-item {
  position: relative;
  padding-bottom: 48rpx;
}

.timeline-item::before {
  content: '';
  position: absolute;
  left: -40rpx;
  top: 8rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background-color: #667eea;
  border: 4rpx solid white;
  box-shadow: 0 0 0 4rpx #667eea;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.alert {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  border: 1px solid transparent;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
}

.alert-overdue {
  border-left: 8rpx solid #e74c3c;
  background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
}

.alert-warning {
  border-left: 8rpx solid #f39c12;
  background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
}

.alert-info {
  border-left: 8rpx solid #3498db;
  background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);
}

.alert-icon {
  font-size: 48rpx;
  flex-shrink: 0;
}

.alert-content {
  flex: 1;
  min-width: 0;
}

.alert-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 8rpx;
  display: block;
}

.alert-message {
  font-size: 28rpx;
  color: #6b7280;
  display: block;
  line-height: 1.5;
}

.alert-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.alert-dismiss {
  background: none;
  border: none;
  font-size: 40rpx;
  color: #6b7280;
  padding: 8rpx;
  border-radius: 12rpx;
  transition: all 0.2s ease;
  line-height: 1;
}

.alert-dismiss:active {
  background-color: rgba(0, 0, 0, 0.1);
  color: #2c3e50;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #2c3e50;
  margin: 0;
  letter-spacing: -1rpx;
  display: block;
}

.view-all-link {
  color: #667eea;
  text-decoration: none;
  font-weight: 600;
