# API Configuration
VITE_API_BASE_URL=http://localhost:8080/api
VITE_API_TIMEOUT=30000

# File Upload Configuration
VITE_MAX_FILE_SIZE=104857600
VITE_SUPPORTED_VIDEO_FORMATS=mp4,avi,mov,wmv,flv,webm
VITE_SUPPORTED_DOCUMENT_FORMATS=pdf,doc,docx,txt,rtf,odt

# Application Configuration
VITE_APP_TITLE=English Learning System
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=IELTS Study Material Management and Vocabulary Learning

# Feature Flags
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_OFFLINE_MODE=false
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG_MODE=false

# Notification Configuration
VITE_NOTIFICATION_PERMISSION_TIMEOUT=10000
VITE_NOTIFICATION_RETRY_INTERVAL=300000

# Performance Configuration
VITE_ENABLE_PERFORMANCE_MONITORING=false
VITE_CHUNK_SIZE_WARNING_THRESHOLD=1000000

# Security Configuration
VITE_ENABLE_CSP=true
VITE_ENABLE_HTTPS_ONLY=false

# Development Configuration
VITE_MOCK_API=false
VITE_LOG_LEVEL=info